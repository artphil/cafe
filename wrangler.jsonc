{
  // Site estático: a Cloudflare publica a pasta gerada pelo `npm run build`.
  "name": "cafealmanaque",
  "compatibility_date": "2026-11-01",
  "assets": {
    "directory": "./dist"
  },
  // O site é servido só por cafealmanaque.com; os endereços de teste ficam
  // desligados para não gerar conteúdo duplicado no Google.
  "workers_dev": false,
  "preview_urls": false
}
